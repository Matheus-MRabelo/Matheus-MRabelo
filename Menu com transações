import java.util.Scanner;

public class desafiojava {
    public static void main(String[] args) {
        String nome = "Sarah Agualuza";
        String tipoConta = "Corrente";
        int escolha = 0;
        double saldoTotal = 0;
        double saldo = 1725.45;
        String msgPadrao = "\nDigite outra operação!\n1- Consultar saldo\n2- Receber valor\n3- Transferir valor\n4- Sair";
        Scanner escolha1 = new Scanner(System.in);
        System.out.println("*************************************\n");
        System.out.println("Nome do Cliente: " + nome);
        System.out.println("Tipo de Conta: " + tipoConta);
        System.out.println("Saldo atual: " + saldo);
        System.out.println("\n************************************* ");
        System.out.println("\n\n ** OPERAÇÕES ** \n\n");
        System.out.println("1- Consultar saldo");
        System.out.println("2- Receber valor");
        System.out.println("3- Transferir valor");
        System.out.println("4- Sair");
        System.out.println("\nEscolha uma opção!");
        escolha = escolha1.nextInt();
        while (escolha != 4) {
            if (escolha == 1) {
                System.out.println("Saldo atual R$: " + saldo);
                System.out.println(msgPadrao);
                escolha = escolha1.nextInt();
            } else if (escolha == 2) {
                int saldoAreceber = 0;
                System.out.println("Insira o valor a ser recebido!");
                saldoAreceber = escolha1.nextInt();
                saldoTotal = saldoAreceber + saldo;
                System.out.println("Saldo atual R$: " + saldoTotal);
                System.out.println(msgPadrao);
                escolha = escolha1.nextInt();
            } else if (escolha == 3) {
                int saldoAtransferir = 0;
                System.out.println("Insira o valor a ser transferido!");
                saldoAtransferir = escolha1.nextInt();
                    if (saldoAtransferir > saldo){
                        System.out.println("Saldo insuficiente para a transação!");
                    } else {
                        saldoTotal = saldo - saldoAtransferir;
                        System.out.println("Saldo atual R$: " + saldoTotal);}
                System.out.println(msgPadrao);
                escolha = escolha1.nextInt();
            } else {
                System.out.println("**********Opção inválida!**********\nDigite novamente a operação desejada!");
                escolha = escolha1.nextInt();
            }

        }
    }
}
